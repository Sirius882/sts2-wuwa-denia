<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <AssemblyName>denia</AssemblyName>
    <EnableDynamicLoading>True</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <TargetFramework>net90</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <NoWarn>STS001;STS002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.3.0" />
    <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.1.9" />
    <PackageReference Include="SmartFormat" Version="3.3.0" />
  </ItemGroup>
  <PropertyGroup>
    <!-- 测试版分支默认引用本工作区刚构建的 beta Aemeath；仍允许环境变量或 /p:AemeathDll 覆盖。 -->
    <AemeathDll Condition="'$(AemeathDll)' == '' and '$(AEMEATH_DLL)' != ''">$(AEMEATH_DLL)</AemeathDll>
    <AemeathDll Condition="'$(AemeathDll)' == ''">$(MSBuildProjectDirectory)\..\..\AemeathSourceCode\.godot\mono\temp\bin\Debug\aemeath-ww.dll</AemeathDll>
    <!-- 测试版分支：sts2 默认指向 GameBeta 的调试构建产物；可用环境变量 STS2_DLL 覆盖为你的测试版游戏安装路径 -->
    <Sts2Dll Condition="'$(Sts2Dll)' == ''">$(STS2_DLL)</Sts2Dll>
    <Sts2Dll Condition="'$(Sts2Dll)' == ''">$(MSBuildProjectDirectory)\..\..\GameBeta\.godot\mono\temp\bin\Debug\sts2.dll</Sts2Dll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2Dll)</HintPath>
    </Reference>
    <Reference Include="aemeath-ww">
      <HintPath>$(AemeathDll)</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\threeDLLs\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
