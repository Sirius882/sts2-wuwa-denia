<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <AssemblyName>denia</AssemblyName>
    <EnableDynamicLoading>True</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <TargetFramework>net90</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <NoWarn>STS001;STS002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.3.0" />
    <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.1.9" />
    <PackageReference Include="SmartFormat" Version="3.3.0" />
  </ItemGroup>
  <PropertyGroup>
    <!-- aemeath-ww 固定从 Steam 工坊订阅路径解析（由环境变量 AEMEATH_DLL 传入），不使用 threeDLLs 副本 -->
    <AemeathDll Condition="'$(AemeathDll)' == ''">$(AEMEATH_DLL)</AemeathDll>
    <!-- sts2 固定从当前游戏安装目录解析，避免与 threeDLLs 中的陈旧副本不一致 -->
    <Sts2Dll Condition="'$(Sts2Dll)' == ''">$(STS2_DLL)</Sts2Dll>
    <Sts2Dll Condition="'$(Sts2Dll)' == ''">E:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64\sts2.dll</Sts2Dll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2Dll)</HintPath>
    </Reference>
    <Reference Include="aemeath-ww">
      <HintPath>$(AemeathDll)</HintPath>
    </Reference>
    <Reference Include="tune_strain">
      <HintPath>..\tune_strain\.godot\mono\temp\bin\Debug\tune_strain.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\threeDLLs\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
