<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <AssemblyName>denia</AssemblyName>
    <EnableDynamicLoading>True</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <TargetFramework>net90</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <NoWarn>STS001;STS002</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Steam 安装的完整多版本运行时；其他机器可通过 RITSULIB_DIR / RitsuLibDirectory 覆盖。 -->
    <RitsuLibDirectory Condition="'$(RitsuLibDirectory)' == ''">$(RITSULIB_DIR)</RitsuLibDirectory>
    <RitsuLibDirectory Condition="'$(RitsuLibDirectory)' == ''">F:\SteamLibrary\steamapps\workshop\content\2868840\3747602295</RitsuLibDirectory>
    <RitsuLibReferenceTarget Condition="'$(RitsuLibReferenceTarget)' == ''">0.111.0</RitsuLibReferenceTarget>
  </PropertyGroup>
  <Import Project="$(RitsuLibDirectory)/RitsuLib.References.props" />
  <ItemGroup>
    <Compile Remove="tools/visuals/execution_preview/Preview.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.3.0" />
    <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.1.9" />
    <PackageReference Include="SmartFormat" Version="3.3.0" />
  </ItemGroup>
  <PropertyGroup>
    <!-- 两个分支默认引用本工作区构建的 Aemeath 公共 API；仍允许环境变量或 /p:AemeathDll 覆盖。 -->
    <AemeathDll Condition="'$(AemeathDll)' == '' and '$(AEMEATH_DLL)' != ''">$(AEMEATH_DLL)</AemeathDll>
    <AemeathDll Condition="'$(AemeathDll)' == ''">$(MSBuildProjectDirectory)\..\..\AemeathSourceCode\.godot\mono\temp\bin\Debug\aemeath-ww.dll</AemeathDll>
    <!-- sts2 固定从当前游戏安装目录解析，避免与快照中的陈旧副本不一致；可用环境变量 STS2_DLL 覆盖。 -->
    <Sts2Dll Condition="'$(Sts2Dll)' == ''">$(STS2_DLL)</Sts2Dll>
    <Sts2Dll Condition="'$(Sts2Dll)' == ''">F:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64\sts2.dll</Sts2Dll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2Dll)</HintPath>
    </Reference>
    <Reference Include="aemeath-ww">
      <HintPath>$(AemeathDll)</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\threeDLLs\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
